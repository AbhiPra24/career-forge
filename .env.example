# ==============================================================================
# CareerForge Configuration Template
# ==============================================================================

# LLM Providers (Optional - used for AI-enhanced evaluation / tailoring)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Web Discovery & Scraping (Optional - fallback uses local BeautifulSoup)
FIRECRAWL_API_KEY=
SERPER_API_KEY=

# Scoring Weights (Normalized 0.0 - 1.0)
WEIGHT_SKILL_MATCH=0.40
WEIGHT_EXP_DEPTH=0.30
WEIGHT_MARKET_DEMAND=0.20
WEIGHT_COMPETITIVE_EDGE=0.10

# Database & Cache Settings
CAREER_FORGE_DB_PATH=jobs_cache.db
CAREER_FORGE_CACHE_TTL_DAYS=14

# Recruiter Radar Settings
DNS_LOOKUP_TIMEOUT_SECONDS=2.0
